{
  "name": "gateway-global-ai-platform",
  "version": "1.0.0",
  "description": "AI-first platform for small business owners. Generate stunning websites with voice, chatbots, and SMS in 30 seconds. Autonomous agents, Twilio telephony, and Google Workspace integration.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "dev:doppler": "doppler run -- npm run dev",
    "build": "tsx script/build.ts",
    "build:sdk": "vite build --config vite.sdk.config.ts",
    "start": "NODE_ENV=production node dist/index.mjs",
    "start:doppler": "doppler run -- npm start",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test:bi": "doppler run -- tsx tests/test-bi-pipeline.ts",
    "setup:boardwalk": "doppler run -- tsx scripts/setup-boardwalk-suites.ts",
    "db:grn:featured-partners": "doppler run -- npx tsx scripts/create-featured-partners-table.ts",
    "db:migrate:nova": "DOPPLER_TOKEN=${DOPPLER_TOKEN:-$DOPPLER_TOKEN_DEV} doppler run -- npx tsx scripts/run-migration.ts migrations/0009_nova_idv_sessions.sql",
    "db:migrate:resellers": "DOPPLER_TOKEN=${DOPPLER_TOKEN:-$DOPPLER_TOKEN_DEV} doppler run -- npx tsx scripts/run-migration.ts migrations/0007_resellers_commissions.sql",
    "test:nova-handshake": "doppler run -- npx tsx scripts/nova-sovereign-handshake-test-flight-001.ts",
    "nova-handshake:prereq": "doppler run -- npx tsx scripts/nova-handshake-prereq-check.ts",
    "check-keys": "doppler run -- npx tsx scripts/check-google-key-permissions.ts",
    "doppler:sync-ports": "./scripts/sync-doppler-ports.sh",
    "doppler:copy-config": "./scripts/doppler-copy-config.sh",
    "kill-port": "doppler run -- ./scripts/kill-port.sh",
    "mcp:generate": "./scripts/gen-cursor-mcp.sh",
    "prepare": "husky",
    "sovereign-guard": "doppler run -- npx tsx scripts/sovereign-guard.ts"
  },
