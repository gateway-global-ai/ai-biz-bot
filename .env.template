# ============================================================================
# GATEWAY GLOBAL AI - CLEAR VOICE TECHNOLOGY CONFIGURATION
# ============================================================================
# ⚠️  CRITICAL: DO NOT EDIT THESE VALUES WITHOUT UNDERSTANDING THE PROTOCOL
# ⚠️  Changes to model names or structure will cause 1007/1008/1011 errors
# ============================================================================

# === CORE IDENTITY: PROTOCOL-LOCKED VALUES ===
# This exact model string is required for bidiGenerateContent on v1beta
GEMINI_MODEL="models/gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_API_VERSION="v1beta"

# Your actual API key (keep this secret, never commit)
GEMINI_API_KEY="your-api-key-here"

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID="ai-biz-bot"

# === VOICE ENGINE CONFIGURATION ===
# Available HD Voices: Puck, Charon, Kore, Fenrir, Aoede
# DO NOT use voice IDs from legacy models (Kore2, Journey, etc)
GEMINI_VOICE_NAME="Puck"

# === AUDIO FLOW SPECIFICATIONS (PCM 16-BIT) ===
# Input: Browser microphone (16kHz mono PCM)
GEMINI_INPUT_SAMPLE_RATE=16000

# Output: Gemini synthesized voice (24kHz mono PCM)
GEMINI_OUTPUT_SAMPLE_RATE=24000

# === SERVER CONFIGURATION ===
PORT=3004
NODE_ENV=production

# === BUFFER CONFIGURATION (COST OPTIMIZATION) ===
# Delay before finalizing voice input (reduces false stops)
# 800ms = Optimal balance (tested, no cutoffs)
# 500ms = Ultra-responsive (may cut trailing words)
# 1000ms = Balanced
# 2000ms = Conservative (very slow speakers or noisy environments)
VOICE_BUFFER_DELAY_MS=800

# === GOOGLE MAPS CONFIGURATION (three-key strategy) ===
# Server-only (IP restricted): Grounding Lite, Places API (New). Do not use for frontend.
GOOGLE_MAPS_API_KEY="your_server_side_maps_key_here"
# Optional: dedicated key for Place ID discovery (Grounding Lite)
# GOOGLE_MAPS_GROUNDING_LITE_API_KEY="optional_grounding_lite_key"

# Server-only (API-service restricted): Generative Language API. Do not expose via /api/config/*
# GEMINI_API_KEY is set above under CORE IDENTITY.

# Client (referrer restricted): used by /api/config/maps-key and build. Exposed in browser.
VITE_GOOGLE_MAPS_KEY="your_client_side_maps_key_here"
# Or: GOOGLE_MAPS_JS_API / GOOGLE_MAPS_JS_KEY (server serves one of these at /api/config/maps-key)

# Google Map ID (for Advanced Markers)
# Create at: https://console.cloud.google.com/google/maps-apis/studio
VITE_GOOGLE_MAP_ID="your_map_id_here"

# === FEATURE FLAGS ===
# Enable confetti animations on success
VITE_ENABLE_CONFETTI=true

# Enable Google Places Picker component
VITE_ENABLE_PLACE_PICKER=true

# === SECURITY NOTES ===
# 1. This file should NEVER be committed to version control
# 2. Use chmod 400 .env on production servers
# 3. For team environments, use a secrets manager (1Password, Doppler, etc.)
# 4. Rotate API keys quarterly or after any suspected exposure
# 5. VITE_ prefixed variables are exposed to the browser - use restricted API keys
# 6. Server-side keys (GOOGLE_MAPS_API_KEY) should have IP restrictions enabled

