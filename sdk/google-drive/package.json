{
  "name": "@gateway-global/google-drive-sdk",
  "version": "1.0.0",
  "description": "SDK for integrating Google Drive API functionality with unified interface for file management, sharing, and collaboration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn examples/basic-usage.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "start:quickstart": "cd examples/quickstart && npm start"
  },
  "keywords": [
    "google-drive",
    "drive-api",
    "google-workspace",
    "file-management",
    "cloud-storage",
    "api",
    "sdk"
  ],
  "author": "Gateway Global AI",
  "license": "MIT",
  "dependencies": {
    "googleapis": "^128.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
