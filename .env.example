# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/gateway_ai

# AI Service Keys
# Kimi 2.5 (Moonshot API) - Primary AI
KIMI_API_KEY=your_kimi_api_key_here

# Google Gemini - Fallback AI
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Stripe Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Replicate (for Kimi-Audio and Flux)
REPLICATE_API_TOKEN=your_replicate_api_token

# HuggingFace (for MCP Server and models)
HUGGINGFACE_TOKEN=your_huggingface_token

# Session Configuration
SESSION_SECRET=your_random_session_secret_here_minimum_32_characters
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# WebSocket Configuration
WS_PORT=3001

# Optional: Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Optional: Redis (if using for session storage)
REDIS_URL=redis://localhost:6379

# Optional: Application URLs
CLIENT_URL=http://localhost:5000
SERVER_URL=http://localhost:3000

# Security
# Generate a strong random string for production
ENCRYPTION_KEY=your_encryption_key_here_minimum_32_characters

# Feature Flags (optional)
ENABLE_VOICE_AI=true
ENABLE_GOOGLE_WORKSPACE=true
ENABLE_A2P_COMPLIANCE=true

# Logging
LOG_LEVEL=debug

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Notes:
# - Replace all "your_*_here" values with actual credentials
# - Never commit .env file to version control
# - Use different values for development, staging, and production
# - Keep this .env.example updated when adding new variables
# - Generate secure random strings for secrets (min 32 chars recommended)
