LOCAL_VOICE_PORT=8000

# Faster-Whisper
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# Kokoro / local TTS
LOCAL_TTS_MODEL=kokoro-v1
LOCAL_TTS_VOICE=default
LOCAL_TTS_SAMPLE_RATE=24000

# Runtime behavior
LOCAL_VOICE_WARMUP=true
LOCAL_VOICE_LOG_LEVEL=info

# Governance / routing posture
LOCAL_VOICE_PRIVACY_MODE=strict_local
LOCAL_VOICE_ALLOW_CLOUD_FALLBACK=false

# Container/runtime directories
LOCAL_MODEL_CACHE_DIR=/models
LOCAL_LOG_DIR=/logs
